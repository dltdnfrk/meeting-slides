# ============================================================
# Meeting Slides - 환경 설정
# ============================================================

# --- STT (whisper.cpp) ---
# whisper-stream 바이너리 경로 (마이크 입력용)
WHISPER_STREAM_BIN=/opt/homebrew/bin/whisper-stream
# whisper-cli 바이너리 경로 (파일 입력용)
WHISPER_CLI_BIN=/opt/homebrew/bin/whisper-cli
# 한국어 모델 경로 (medium 권장, large-v3 도 가능)
WHISPER_MODEL_PATH=./models/ggml-medium.bin
# 캡처 디바이스 ID (-1=기본 입력). 목록 확인: bun run devices
# 예: MacBook Pro 마이크가 #1이면 WHISPER_CAPTURE_ID=1
WHISPER_CAPTURE_ID=-1
# 스레드 수
WHISPER_THREADS=4
# 오디오 스텝 (ms) - 작을수록 실시간성 높음, 정확도 감소
WHISPER_STEP_MS=3000

# --- 입력 모드 ---
# mic | file (기본 mic). file 모드는 WHISPER_FILE_PATH 필수.
# 런타임 인자로도 제어: bun run server.ts --file ./sample.m4a
WHISPER_INPUT_MODE=mic
# file 모드일 때 전사할 오디오 파일 경로
WHISPER_FILE_PATH=

# --- LLM 프로바이더 (OpenAI-compatible) ---
# alibaba | openai | local | cli
# cli: LLM API 키 없이 구독 중인 서비스의 CLI(claude/codex)를 백엔드로 사용
LLM_PROVIDER=alibaba

# --- 구독 서비스 CLI 백엔드 (LLM_PROVIDER=cli 일 때) ---
# claude(Claude Pro/Max 구독) 또는 codex(ChatGPT 구독). 인증은 각 CLI에 위임.
LLM_CLI_BIN=claude
# 프리셋 (claude|codex). 비우면 LLM_CLI_BIN 이름에서 자동 감지
LLM_CLI_PRESET=
# CLI 호출 상한 (ms). CLI는 API보다 느리므로 넉넉하게
LLM_CLI_TIMEOUT_MS=120000

# --- Alibaba Token Plan (Bailian) ---
# /compatible-mode/v1: OpenAI 호환 엔드포인트
ALIBABA_TOKEN_PLAN_API_KEY=sk-sp-xxxxx
ALIBABA_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_TOKEN_PLAN_MODEL=glm-5.2

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- 로컬 llama.cpp 서버 ---
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen3-7b

# --- 블록 감지 설정 ---
# LLM 호출 간격 (문장 수). N문장 누적 시마다 블록 감지 호출
BLOCK_DETECT_SENTENCE_INTERVAL=4
# 컨텍스트 윈도우 (최근 N문장을 LLM에 전달)
BLOCK_CONTEXT_WINDOW=12

# --- 서버 ---
HTTP_PORT=8787
